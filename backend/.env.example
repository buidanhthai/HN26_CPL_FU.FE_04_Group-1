# CozySpace Backend Environment Variables Configuration

# Application Port (automatically set by Render, defaults to 5201 if empty)
PORT=5201

# Production SQL Server Database Connection String (Replace with your actual hosted SQL Server Connection String)
CONNECTION_STRING=Server=your-db-host.com;Database=CozySpaceDB;User Id=your-username;Password=your-password;TrustServerCertificate=True;MultipleActiveResultSets=true;

# JWT Authentication Configuration
Jwt__Key=YourSuperSecretKeyWithAtLeast32CharactersSecurity12345!
Jwt__Issuer=https://your-backend-app.onrender.com
Jwt__Audience=https://your-backend-app.onrender.com

# CORS Configuration (comma-separated origins, or * to allow all)
ALLOWED_ORIGINS=*

# Automatic database demo data seeding (set to true if you want to prepopulate database on production)
SEED_DATA=true
